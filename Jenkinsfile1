pipeline {
    agent any

    environment {
        DOCKERHUB_CREDENTIALS = credentials('dockerhub-creds')
    }

    stages {
       

        stage('Build Docker Images') {
            steps {
                sh 'docker compose -f docker-compose.yaml build || docker-compose -f docker-compose.yaml build'
            }
        }

        stage('Run Backend Smoke Test') {
            steps {
                sh 'docker compose run backend echo "Backend container ran successfully" || docker-compose run backend echo "Backend container ran successfully"'
            }
        }

        stage('Restart Containers') {
            steps {
                sh '''
                    # Kill and remove any container using port 5001 or 3000
                    docker ps --filter "status=running" --format "{{.ID}} {{.Ports}}" | grep -E ":5001->|:3000->" | awk '{print $1}' | xargs -r docker stop || true
                    docker ps -a --format "{{.ID}} {{.Ports}}" | grep -E ":5001->|:3000->" | awk '{print $1}' | xargs -r docker rm -f || true

                    # Remove all *_run containers
                    docker rm -f $(docker ps -aq --filter "name=_run") || true

                    # Shut down and remove orphans
                    docker-compose down --remove-orphans || true

                    # Prune all stopped containers
                    docker container prune -f

                    # Recreate all containers cleanly
                    docker-compose up -d --force-recreate
                '''
            }
        }

        stage('Push to DockerHub') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'dockerhub-creds', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                    sh '''
                        echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
                        docker tag movie-reviews-classification_backend shreya1221/movie-review-app-backend:latest
                        docker tag movie-reviews-classification_frontend shreya1221/movie-review-app-frontend:latest
                        docker push shreya1221/movie-review-app-backend:latest
                        docker push shreya1221/movie-review-app-frontend:latest
                    '''
                }
            }
        }
    }
}
