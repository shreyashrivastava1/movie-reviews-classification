pipeline {
    agent any

    environment {
        DOCKERHUB_CREDENTIALS = credentials('dockerhub-creds')
        IMAGE_NAME = 'shreyashrivastava/movie-sentiment-app'
    }

    stages {
        stage('Checkout Code') {
            steps {
                git url: 'https://github.com/shreyashrivastava1/movie-reviews-classification.git', branch: 'dev'
            }
        }

        stage('Build Docker Images') {
            steps {
                sh 'docker compose -f docker-compose.yml build || docker-compose -f docker-compose.yml build'
            }
        }

        stage('Run Backend Smoke Test') {
            steps {
                sh 'docker compose run backend echo "Backend container ran successfully" || docker-compose run backend echo "Backend container ran successfully"'
            }
        }

        stage('Push to DockerHub') {
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', 'dockerhub-creds') {
                        sh "docker tag movie-sentiment-backend ${IMAGE_NAME}:backend-dev"
                        sh "docker tag movie-sentiment-frontend ${IMAGE_NAME}:frontend-dev"
                        sh "docker push ${IMAGE_NAME}:backend-dev"
                        sh "docker push ${IMAGE_NAME}:frontend-dev"
                    }
                }
            }
        }

        stage('Deploy to Server') {
            steps {
                sshagent(['your-server-key']) {
                    sh '''
                    ssh user@yourserver "cd /app && git pull && docker compose down && docker compose up -d --build"
                    '''
                }
            }
        }
    }
}
